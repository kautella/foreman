{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreman.local/contracts/task/worktree-marker.schema.json",
  "title": "Foreman task worktree ownership marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "project_slug", "task_type", "repository_path", "git_common_dir", "worktree_path", "git_dir", "base_commit", "branch", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^task-[0-9a-f]{12}$"},
    "project_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "task_type": {"enum": ["change", "research"]},
    "repository_path": {"type": "string", "pattern": "^/"},
    "git_common_dir": {"type": "string", "pattern": "^/"},
    "worktree_path": {"type": "string", "pattern": "^/"},
    "git_dir": {"type": "string", "pattern": "^/"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
    "branch": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "allOf": [
    {"if": {"properties": {"task_type": {"const": "change"}}}, "then": {"properties": {"branch": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"task_type": {"const": "research"}}}, "then": {"properties": {"branch": {"type": "null"}}}}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreman.local/contracts/task/handoff.schema.json",
  "title": "Foreman local change handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "task_id", "created_at", "kind", "branch", "base_commit", "head_commit", "validation_records", "risks", "instructions"],
  "properties": {
    "schema_version": {"const": 1},
    "handoff_id": {"type": "string", "pattern": "^handoff-[0-9a-f]{12}$"},
    "task_id": {"type": "string", "pattern": "^task-[0-9a-f]{12}$"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "kind": {"const": "local-change"},
    "branch": {"type": "string", "minLength": 1},
    "base_commit": {"$ref": "#/$defs/gitCommit"},
    "head_commit": {"$ref": "#/$defs/gitCommit"},
    "validation_records": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
    "risks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "instructions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreman.local/contracts/task/event.schema.json",
  "title": "Foreman task event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "task_id", "sequence", "at", "kind", "actor", "from", "to", "message", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^event-[0-9a-f]{12}$"},
    "task_id": {"type": "string", "pattern": "^task-[0-9a-f]{12}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "at": {"$ref": "#/$defs/timestamp"},
    "kind": {"enum": ["lifecycle-transition", "condition-observed", "reconciliation"]},
    "actor": {"enum": ["foreman", "agent-adapter", "runtime-adapter", "validation", "recovery"]},
    "from": {"$ref": "#/$defs/lifecycle"},
    "to": {"$ref": "#/$defs/lifecycle"},
    "message": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "condition"],
      "properties": {
        "status": {"enum": ["planned", "approved", "prepared", "running", "awaiting-reconciliation", "validated", "delivery-ready", "change-request-ready", "report-ready", "landed", "teardown-ready", "closed"]},
        "condition": {"oneOf": [{"type": "null"}, {"enum": ["blocked", "failed", "missing", "unreachable", "unknown"]}]}
      }
    }
  }
}

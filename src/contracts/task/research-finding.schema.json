{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreman.local/contracts/task/research-finding.schema.json",
  "title": "Foreman research finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "task_id", "created_at", "title", "summary", "confidence", "evidence", "report_path"],
  "properties": {
    "schema_version": {"const": 1},
    "finding_id": {"type": "string", "pattern": "^finding-[0-9a-f]{12}$"},
    "task_id": {"type": "string", "pattern": "^task-[0-9a-f]{12}$"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["low", "medium", "high"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "description"],
        "properties": {
          "kind": {"enum": ["file", "url", "command-output"]},
          "reference": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "report_path": {"type": "string", "pattern": "^/"}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}

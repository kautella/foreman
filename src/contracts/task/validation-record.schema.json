{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreman.local/contracts/task/validation-record.schema.json",
  "title": "Foreman task validation record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validation_id", "task_id", "sequence", "command", "working_directory", "started_at", "finished_at", "exit_status", "outcome", "output", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "validation_id": {"type": "string", "pattern": "^validation-[0-9a-f]{12}$"},
    "task_id": {"type": "string", "pattern": "^task-[0-9a-f]{12}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "command": {"type": "string", "minLength": 1},
    "working_directory": {"type": "string", "pattern": "^/"},
    "started_at": {"$ref": "#/$defs/timestamp"},
    "finished_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
    "exit_status": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 255}]},
    "outcome": {"enum": ["passed", "failed", "paused", "blocked", "missing", "unreachable", "unknown"]},
    "output": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/output"}]},
    "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "passed"}}}, "then": {"properties": {"finished_at": {"type": "string"}, "exit_status": {"const": 0}, "output": {"type": "object"}}}},
    {"if": {"properties": {"outcome": {"const": "failed"}}}, "then": {"properties": {"finished_at": {"type": "string"}, "exit_status": {"type": "integer", "minimum": 1}, "output": {"type": "object"}}}},
    {"if": {"properties": {"outcome": {"enum": ["paused", "blocked", "missing", "unreachable", "unknown"]}}}, "then": {"properties": {"exit_status": {"type": "null"}}}}
  ]
}

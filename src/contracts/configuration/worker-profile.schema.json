{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreman.local/contracts/configuration/worker-profile.schema.json",
  "title": "Foreman worker profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "model",
    "reasoning"
  ],
  "properties": {
    "agent": {
      "type": "string",
      "enum": [
        "claude",
        "codex",
        "gemini",
        "opencode",
        "pi"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    }
  }
}

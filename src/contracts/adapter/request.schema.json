{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreman.local/contracts/adapter/request.schema.json",
  "title": "Foreman normalized adapter request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "adapter",
    "operation",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "runtime",
            "remote"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "payload": {
      "type": "object"
    }
  }
}

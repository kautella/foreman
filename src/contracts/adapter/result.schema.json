{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreman.local/contracts/adapter/result.schema.json",
  "title": "Foreman normalized adapter result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "adapter",
    "operation",
    "ok",
    "status",
    "data",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "runtime",
            "remote"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "unavailable",
        "unsupported",
        "ambiguous"
      ]
    },
    "data": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "then": {
        "not": {
          "properties": {
            "status": {
              "const": "ok"
            }
          }
        }
      }
    }
  ]
}

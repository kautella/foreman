{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreman.local/contracts/adapter/manifest.schema.json",
  "title": "Foreman adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "kind",
    "id",
    "display_name",
    "executable",
    "status",
    "operations",
    "capabilities",
    "profile"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "agent",
        "runtime",
        "remote"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "executable": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._+-]+$"
    },
    "status": {
      "const": "contract-only"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "profile": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_required",
            "reasoning_required",
            "validation"
          ],
          "properties": {
            "model_required": {
              "type": "boolean"
            },
            "reasoning_required": {
              "type": "boolean"
            },
            "validation": {
              "const": "provider-adapter"
            }
          }
        }
      ]
    }
  }
}
